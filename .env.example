# Golden Records API credentials.
#
# Copy this file to `.env` and fill in the values. `.env` is gitignored so your
# credentials stay out of source control; this template is safe to commit.
#
#   cp .env.example .env
#
# Two authentication schemes are supported. The API key takes precedence when
# set -- prefer it: a club-level key returns the whole membership, whereas
# Basic Auth returns only the authenticating user's own member record.

# API key (recommended). Sent as "Authorization: Basic <key>".
GOLDEN_RECORDS_API_KEY=

# HTTP Basic Auth (fallback, used only when the API key above is blank).
GOLDEN_RECORDS_USERNAME=
GOLDEN_RECORDS_PASSWORD=
